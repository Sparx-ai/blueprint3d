{
  "compilerOptions": {
    "target": "es5",
    "module": "amd",
    "lib": ["dom", "es2015"],
    "outFile": "dist/blueprint3d.js",
    "declaration": true,
    "sourceMap": true,
    "removeComments": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
} 